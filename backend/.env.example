# 复制为 .env 并填入你的配置
# 多模型注册表见 models.json；这里的变量通过 ${VAR} 注入其中

# MiMo（小米）
MIMO_BASE_URL=
MIMO_API_KEY=

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# 自定义 OpenAI 兼容接口
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# 配音（edge-tts 免费微软音色）
TTS_VOICE=zh-CN-YunjianNeural
TTS_RATE=+6%
# edge-tts 偶发空音频/断连：重试次数、单次超时（秒）、退避基数（秒）
TTS_RETRIES=3
TTS_TIMEOUT_SECONDS=90
TTS_RETRY_DELAY=1.5

# 渲染引擎（仓库内的 remotion-engine 项目路径）
REMOTION_DIR=D:/work/Video_Workflow/remotion-engine

# 存储目录（默认 backend/storage）
# STORAGE_DIR=

# 在线免版权曲库（可选；不配也能用 Openverse 匿名额度）
# Openverse：api.openverse.org 免费注册获取 token，匿名额度较低（每天少量请求）
OPENVERSE_TOKEN=
# Jamendo：devportal.jamendo.com 免费申请 client id，不填则跳过该源
JAMENDO_CLIENT_ID=

# ---- 抖音官方 OpenAPI 推送（可选；不配置则发布面板走半自动模式）----
# 1) open.douyin.com 注册应用（需要视频发布能力/权限）
# 2) 回调地址需与注册一致；本地可起一个极简回调页或用手动复制 code 的方式
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=

# ---- 六步流程第4步：AI 现场编写定制场景（可选；默认关闭，前端开关控制）----
# 生成时调用的本地 coding agent CLI（自动探测顺序 zcode → claude → command-code）
# 也可强制指定，如 GEN_AGENT_CMD=claude 或 GEN_AGENT_CMD=command-code
GEN_AGENT_CMD=
# 单次 agent 编写超时（秒，默认 900）
GEN_AGENT_TIMEOUT=
# 每个项目生成的定制场景数量上限（2~5，默认 3）
GEN_MAX_BEATS=
# 单个 agent 会话编写的场景数量（其余场景自动分到后续会话；默认 5）
GEN_AGENT_BATCH=

# ---- ComfyUI 生成节点（3060 主机；先跑 tools/comfyui-setup）----
# 3060 启动后把 IP 换成它的局域网地址，例如 http://192.168.1.50:8188
COMFYUI_URL=
# 单次生成/轮询超时（秒）
COMFYUI_TIMEOUT=600
