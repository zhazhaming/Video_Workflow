# 复制为 .env 并填入你的配置
# 多模型注册表见 models.json；这里的变量通过 ${VAR} 注入其中

# MiMo（小米）
MIMO_BASE_URL=
MIMO_API_KEY=

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# 自定义 OpenAI 兼容接口
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# 配音（edge-tts 免费微软音色）
TTS_VOICE=zh-CN-YunjianNeural
TTS_RATE=+6%
# edge-tts 偶发空音频/断连：重试次数、单次超时（秒）、退避基数（秒）
TTS_RETRIES=3
TTS_TIMEOUT_SECONDS=90
TTS_RETRY_DELAY=1.5

# 渲染引擎（仓库内的 remotion-engine 项目路径）
REMOTION_DIR=D:/work/Video_Workflow/remotion-engine

# 存储目录（默认 backend/storage）
# STORAGE_DIR=

# 在线免版权曲库（可选；不配也能用 Openverse 匿名额度）
# Openverse：api.openverse.org 免费注册获取 token，匿名额度较低（每天少量请求）
OPENVERSE_TOKEN=
# Jamendo：devportal.jamendo.com 免费申请 client id，不填则跳过该源
JAMENDO_CLIENT_ID=

# ---- 抖音官方 OpenAPI 推送（可选；不配置则发布面板走半自动模式）----
# 1) open.douyin.com 注册应用（需要视频发布能力/权限）
# 2) 回调地址需与注册一致；本地可起一个极简回调页或用手动复制 code 的方式
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=

# ---- 六步流程第4步：AI 现场编写定制场景（可选；默认关闭，前端开关控制）----
# 生成时调用的本地 coding agent CLI（自动探测顺序 zcode → claude → command-code）
# 也可强制指定，如 GEN_AGENT_CMD=claude 或 GEN_AGENT_CMD=command-code
GEN_AGENT_CMD=
# 单次 agent 编写超时（秒，默认 900）
GEN_AGENT_TIMEOUT=
# 每个项目生成的定制场景数量上限（2~5，默认 3）
GEN_MAX_BEATS=
# 单个 agent 会话编写的场景数量（其余场景自动分到后续会话；默认 5）
GEN_AGENT_BATCH=

# ---- ComfyUI 生成节点（3060 主机；先跑 tools/comfyui-setup）----
# 3060 启动后把 IP 换成它的局域网地址，例如 http://192.168.1.50:8188
COMFYUI_URL=
# 单次生成/轮询超时（秒）
COMFYUI_TIMEOUT=600

# ---- 发布中心（创作者中心自动化：扫码登录 + 预约发布到抖音）----
# 登录方式：前端「发布」Tab 扫码（用抖音 App 扫，系统不接触账号密码），会话只存本机 storage/
# 浏览器二进制安装在仓库内 backend/.pw-browsers（不占 C 盘）。首次安装（PowerShell）：
#   $env:PLAYWRIGHT_BROWSERS_PATH="D:\Work\video-workflow\backend\.pw-browsers"
#   pip install --no-cache-dir playwright
#   $env:PLAYWRIGHT_DOWNLOAD_HOST="https://npmmirror.com/mirrors/playwright/"   # 国内网络建议加镜像
#   python -m playwright install chromium
# 调度 tick（秒，默认 30）
PUBLISH_TICK_SECONDS=
# 错过排期的补发宽限（小时，默认 24；超过转 overdue 待人工）
PUBLISH_MISSED_GRACE_HOURS=
# 两次上传最小间隔（分钟，默认 10；降低风控风险）
PUBLISH_MIN_INTERVAL_MINUTES=
# 新建任务默认合集名（空=不设合集，前端可按任务覆盖；合集需账号已开通该功能）
DOUYIN_COLLECTION=
# 新建任务默认自主声明（逗号分隔，默认「内容由AI生成」，前端可按任务覆盖）
DOUYIN_DECLARATIONS=
# 每日自动回流作品表现数据到发布台账（默认 1；需已扫码登录，登录态失效自动跳过）
PUBLISH_STATS_SYNC=

# ---- 视频流水线（每日热点自动出片，执行体为本地 DeepSeek Harness 桌面端无头模式）----
# 每天 HH:MM 自动按第一波指数选热点、派 dsh agent 出片（0/关闭，1/开启）
DAILY_PIPELINE_ENABLED=
DAILY_PIPELINE_HOUR=
DAILY_PIPELINE_MINUTE=
DAILY_PIPELINE_COUNT=
# 单条视频目标时长（秒，15~240）
DAILY_PIPELINE_TARGET_SECONDS=
# dsh 无头启动器路径（默认 D:\Software\dsh-desktop\resources\runtime\cli\bin\dsh.cmd）
DAILY_AGENT_CMD=
# dsh profile（默认 headless；一次性任务模式，--json 事件流）
DAILY_AGENT_PROFILE=
# 单个 dsh 会话超时（秒，默认 5400=90 分钟）
DAILY_AGENT_TIMEOUT=
# 候选确认窗口（分钟）：先把 10 条候选推飞书，窗口内可点选做哪几条，超时按默认前 N 条开做
DAILY_PIPELINE_CONFIRM_MINUTES=
# 飞书群自定义机器人 webhook（群设置→群机器人→自定义机器人，空=不推送仅本地候选）
FEISHU_WEBHOOK_URL=
# 成片亮度闸门（0~1，抽帧灰度均值双双低于该值判失败；守住「不要深色 AI 味背景」）
DAILY_PIPELINE_MIN_BRIGHTNESS=
# 事实审计硬闸门：审计不过自动派返修会话的最大重试次数（默认 3；0=不重试直接失败）
DAILY_FACTS_RETRIES=
# 制作结果/异常告警推送飞书（默认 1；0=关闭，候选推送不受影响）
DAILY_NOTIFY_RESULTS=
